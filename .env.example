# Sentinel Sync Service — environment variables

DATABASE_URL=postgresql+psycopg://sync:sync@localhost:5432/sentinel_sync

# Where this service validates Bearer license keys against.
LICENSE_SERVICE_URL=https://sentinel-license.fly.dev
ENTITLEMENT_CACHE_SECONDS=300

# Cap on rows accepted in one push request.
MAX_ROWS_PER_PUSH=1000

# Error tracking (optional). Blank in local dev — init_sentry() no-ops.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Rate-limiter shared storage. Without it, per-process in-memory
# counters — fine for a single-machine deploy.
REDIS_URL=
